# Auth.js
AUTH_SECRET=                 # openssl rand -base64 32
AUTH_DISCORD_ID=             # Discord Developer Portal → OAuth2. Redirect: http://localhost:3000/api/auth/callback/discord (배포: https://<domain>/api/auth/callback/discord)
AUTH_DISCORD_SECRET=
AUTH_DEV_LOGIN=0             # 1 이면 로컬에서 Discord 없이 dev 로그인 허용 (production 에서는 무시됨)
# AUTH_URL=https://example.com   # 배포 시 필수. sitemap/robots 의 기준 URL 로도 사용. 로컬은 자동 감지
# AUTH_TRUST_HOST=1              # 배포 시 필수 (nginx 뒤에서 X-Forwarded-Host 신뢰)

# 넥슨 Open API
NEXON_SERVER_API_KEY=        # 서버 공용 키 (공개 조회 /lookup, 닉네임 확인). 유저 키가 없을 때만 사용
# NEXON_SERVER_RATE_PER_SEC=500  # 서비스 키 발급 후. dev 키는 5 (기본값)
NEXON_KEY_ENC_SECRET=        # openssl rand -base64 32  (유저 API 키 암호화)

# DB / 잡
DATABASE_PATH=./data/app.db
CRON_ENABLED=0               # 1 이면 서버 프로세스 안에서 node-cron 실행 (배포는 ecosystem.config.js 가 1 로 지정)
JOBS_SECRET=                 # POST /api/jobs/<name> Bearer 토큰
# JOBS_LOOPBACK_ONLY=1       # production 기본 1: /api/jobs 는 127.0.0.1 에서 온 요청만 (X-Real-IP 기준). 0 이면 해제
WEEKLY_WORLD_SALE_LIMIT=90   # 월드당 주간 결정 판매 한도 (공식 미확인)
# BACKUP_KEEP_DAYS=14        # deploy/backup-db.sh 보관 일수
